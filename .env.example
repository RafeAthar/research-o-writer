# Copy to .env and fill in. Never commit .env.

# --- Backend ---
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# Single-user auth in Phase 1: a long random string; sent as X-Auth-Token header.
APP_AUTH_TOKEN=change-me-to-a-long-random-string
APP_DEFAULT_USER_ID=1

# Max upload size in MB (rejected with 413 above this).
MAX_UPLOAD_MB=50

# Comma-separated allowed CORS origins for the API.
CORS_ORIGINS=http://localhost:3000

# Preload the embedder + reranker at API startup (background thread) so the
# first chat isn't slowed by the model load. Set false to load lazily instead.
WARM_MODELS_ON_STARTUP=true

# Postgres. Hosts below assume the backend runs on your machine (make
# backend-dev) while infra runs in docker with ports published to localhost.
# If you instead run the backend inside the compose network, use the service
# names (postgres / redis / minio) here.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=research_o_writer
POSTGRES_USER=row
POSTGRES_PASSWORD=row_dev_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=row_minio_access
S3_SECRET_KEY=row_minio_secret
S3_BUCKET=research-o-writer
S3_REGION=us-east-1

# Anthropic (Claude) — for chat / synthesis. Embeddings & rerank are local.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
ANTHROPIC_MODEL_HARD=claude-opus-4-7

# Embedding model (local; see backend/app/services/embedder.py)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_TOKEN=change-me-to-a-long-random-string
